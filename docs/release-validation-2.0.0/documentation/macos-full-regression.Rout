+   diagnostics <- character()
+   figure <- withCallingHandlers(
+     dsldFreqPCoord(frame, 10, "group", method = "randsamp", k = 5, klm = 10),
+     warning = function(warning) {
+       diagnostics <<- c(diagnostics, conditionMessage(warning))
+       invokeRestart("muffleWarning")
+     })
+   stopifnot(inherits(figure, "ggplot"), any(grepl("constant within", diagnostics)),
+             setequal(as.character(unique(figure$data$variable)), c("x", "z", "y")))
+   errors(dsldFreqPCoord(frame[c("category", "group")], 10, "group", k = 5),
+          "varies within every plotted group")
+ })
PASS: parallel coordinates handle unused factor levels 
Warning message:
Omitting parallel-coordinate axes constant within a plotted group: category.u, category.v 
> if (requireNamespace("Matching", quietly = TRUE)) {
