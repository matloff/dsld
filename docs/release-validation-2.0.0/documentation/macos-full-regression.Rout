> # Deterministic checks of numerical results, public behavior, and edge cases.
> # Run with Rscript tests/regression.R after installing this checkout.
> suppressPackageStartupMessages(library(dsld))
> stopifnot(as.character(packageVersion("dsld")) == "2.0.0")
> failures <- character()
> checks <- 0L
> check <- function(label, code) {
+   checks <<- checks + 1L
+   tryCatch({ force(code); cat("PASS:", label, "\n") }, error = function(error) {
+     failures <<- c(failures, paste(label, conditionMessage(error), sep = ": "))
+     cat("FAIL:", tail(failures, 1L), "\n")
+   })
+ }
> equal <- function(actual, expected, tolerance = 1e-7) {
+   comparison <- all.equal(unname(actual), unname(expected), tolerance = tolerance,
+                            check.attributes = FALSE)
+   if (!isTRUE(comparison)) stop(paste(comparison, collapse = "; "))
+ }
> errors <- function(code, pattern = ".") {
+   message <- tryCatch({force(code); NULL}, error = function(error) conditionMessage(error))
+   if (is.null(message) || !grepl(pattern, message)) stop("Expected error matching: ", pattern)
+ }
> set.seed(910)
> data <- data.frame(x = rnorm(160), z = rnorm(160),
+                    group = factor(rep(c("a", "b"), 80)))
> data$y <- 2 + 3 * data$x + 0.5 * data$z + as.integer(data$group == "b") + rnorm(160)
> binary <- data
> binary$y <- factor(ifelse(binary$x + 0.15 * binary$z + rnorm(160, sd = .15) > 0, "yes", "no"))
> predictors <- data[, c("x", "z", "group")]
> 
