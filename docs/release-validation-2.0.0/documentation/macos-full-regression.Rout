> check("linear SE respects dotted names and sum contrasts", {
+   frame <- data; names(frame)[1] <- "x.value"
+   contrasts(frame$group) <- contr.sum(2)
+   fitted <- dsldLinear(frame, "y", "group", useSandwich = TRUE)
+   new_data <- frame[1:4, c("group", "z", "x.value")]
+   reference_model <- lm(y ~ ., frame)
+   design <- model.matrix(delete.response(terms(reference_model)), new_data,
+                          contrasts.arg = reference_model$contrasts)
+   reference_se <- sqrt(diag(design %*% sandwich::sandwich(reference_model) %*% t(design)))
+   equal(predict(fitted, new_data)$standardError, reference_se)
+ })
PASS: linear SE respects dotted names and sum contrasts 
> check("group models retain explicitly supplied sensitive contrasts", {
