+     for (backend in c("glm", "knn")) {
+       set.seed(312)
+       model <- dsldMatchedATE(data, "y", "group", "b", propensFtn = backend, k = 9)
+       stopifnot(is.finite(model$est))
+     }
+     frame <- binary; frame$y <- as.integer(frame$y == "yes")
+     set.seed(810); first <- dsldMatchedATE(frame, "y", "group", "b", yesYVal = 1)
+     set.seed(810); second <- dsldMatchedATE(frame, "y", "group", "b", yesYVal = 0)
+     equal(first$est, -second$est)
+   })
+ }
