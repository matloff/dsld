+   fitted <- dsldLogit(frame, "y", "group", yesYVal = "1")
+   reference <- glm(y ~ ., frame, family = binomial())
+   stopifnot(identical(names(coef(fitted)[[1L]]), names(coef(reference))))
+   equal(coef(fitted)[[1L]], coef(reference))
+   actual <- withCallingHandlers(predict(fitted, frame),
